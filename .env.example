PORT=3000
BMS_PERSISTENCE=true
BMS_DEMO_MODE=true
BMS_DEMO_OTP=123456
BMS_JWT_SECRET=replace-with-a-long-random-secret
BMS_TRANSFER_LIMIT=200000
BMS_AUDIT_RETENTION_DAYS=2555

# Optional encryption for the local JSON demo store. Use a strong secret outside source control.
BMS_STORE_ENCRYPTION_KEY=

# Optional HTTPS/TLS 1.2+ local/deployment support.
# Provide both key and certificate paths to start the server with HTTPS.
BMS_TLS_KEY_FILE=
BMS_TLS_CERT_FILE=
BMS_TLS_CA_FILE=

